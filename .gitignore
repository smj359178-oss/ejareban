# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Local runtime data — never publish the SQLite database (contains user
# data and password hashes), dev server pid files, or agent tool dumps.
db/
.zscripts/dev.pid
tool-results/

# Local project archives may embed the SQLite database above.
/upload/

# The project is bun-based (bun.lock is tracked); npm lockfiles are noise.
package-lock.json
.vercel
.env*
