# ---------------------------------------------------------------------
# Ejareban — environment template.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env` —
# it is ignored by git (.gitignore) and holds real secrets.
#
#   cp .env.example .env
#
# Generate a strong SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------

# Prisma database connection string.
#   - Local dev (SQLite):          file:./db/custom.db
#   - Production on Vercel:        a hosted Postgres URL, e.g.
#     postgresql://USER:PASSWORD@HOST:5432/ejareban?sslmode=require
#     (SQLite files do not persist on serverless platforms.)
DATABASE_URL="file:./db/custom.db"

# HMAC key that signs session tokens (src/lib/auth.ts).
# Required in production — the app refuses to start without it (min 32 chars).
SESSION_SECRET=""
